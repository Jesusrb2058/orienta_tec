{
  "rules": {
    "mapa": { 
      ".read": true, 
      ".write": true 
    },
    "version_app": { 
      ".read": true, 
      ".write": true 
    },
    "fotos": {
      "$salon": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['d','t']) && newData.child('d').isString() && newData.child('d').val().length < 900000",
        "d": { ".validate": "newData.isString()" },
        "t": { ".validate": "newData.isNumber()" },
        "$otro": { ".validate": false }
      }
    },
    "comentarios": {
      ".read": true,
      ".write": true,
      "$id": {
        ".validate": "newData.hasChildren(['texto']) && newData.child('texto').isString() && newData.child('texto').val().length <= 500",
        "texto": { ".validate": "newData.isString()" },
        "salon": { ".validate": "newData.isString() && newData.val().length < 150" },
        "t": { ".validate": "newData.isNumber()" },
        "$otro": { ".validate": false }
      }
    }
  }
}